# =============================================================================
# Configuração do backend Django (copie para .env e ajuste).
# =============================================================================

# Em produção: DEBUG=False e defina uma SECRET_KEY forte e única.
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# -----------------------------------------------------------------------------
# Banco de dados
# Opção A: DATABASE_URL (recomendado em produção)
#   DATABASE_URL=postgresql://user:senha@host:5432/openehr
# Opção B: variáveis DB_* (Postgres)
# Se nada for definido, o Django usa SQLite local (apenas desenvolvimento).
# -----------------------------------------------------------------------------
DATABASE_URL=
DB_NAME=openehr_db
DB_USER=fhir_user
DB_PASSWORD=fhir_secure_password_123
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# FHIR
# -----------------------------------------------------------------------------
FHIR_SERVER_URL=http://localhost:8080/fhir
FHIR_SERVER_TIMEOUT=30

# -----------------------------------------------------------------------------
# Keycloak (autenticação)
# -----------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=openehrcore
KEYCLOAK_CLIENT_SECRET=
# Hardening de validação de token (habilite em produção quando aplicável):
# KEYCLOAK_AUDIENCE=openehrcore        # ativa verificação de audience
# KEYCLOAK_VERIFY_ISSUER=True          # ativa verificação de issuer
# KEYCLOAK_ISSUER=                     # issuer esperado (se != KEYCLOAK_URL/realm)

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Rate limiting / throttling
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=True
THROTTLE_ANON=30/minute
THROTTLE_USER=1000/hour

# -----------------------------------------------------------------------------
# Segurança (produção, aplicado quando DEBUG=False)
# -----------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://app.grephub.com.br,https://grephub.com.br

# -----------------------------------------------------------------------------
# IA (open-source / self-hosted, API compatível com OpenAI)
# Os dados NÃO saem do seu ambiente (LGPD). Produção: vLLM; Dev: Ollama.
# -----------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_VISION_MODEL=qwen2.5vl:7b
LLM_API_KEY=
LLM_TIMEOUT=60
# Transcrição de voz (faster-whisper-server / whisper.cpp, compatível com OpenAI)
ASR_BASE_URL=http://localhost:8001/v1
ASR_MODEL=Systran/faster-whisper-large-v3
ASR_API_KEY=
# RAG (manual clínico) — opcional
RAG_ENABLED=False
EMBEDDINGS_MODEL=bge-m3
RAG_DOCS_DIR=data/clinical_docs
RAG_INDEX_PATH=data/knowledge_index.json
RAG_TOP_K=5
RAG_MIN_SCORE=0.30
# HF_TOKEN só é necessário para o fallback de transcrição MedASR local (requirements-ml.txt)
HF_TOKEN=
